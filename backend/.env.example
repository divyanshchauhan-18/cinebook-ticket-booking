# Copy to .env and fill in values. NEVER commit .env
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cinebook
MONGO_URI_TEST=mongodb://127.0.0.1:27017/cinebook_test
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000
# Set to "false" if the frontend is hosted separately (Netlify/Vercel)
SERVE_FRONTEND=true
